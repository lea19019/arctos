# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/

# Environments
.env
.venv/
.venv-*/
env/
venv/
.uv/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# compression/ — the interpretability + quantization research track.
# Everything under results/ is regenerable by re-running the SLURM jobs; the
# numbers that back the writeups live in docs/findings/.
# ---------------------------------------------------------------------------
/compression/data/
/compression/models/
/compression/outputs/
/compression/results/
/compression/logs/
# Derived calibration text (regenerate via precache.py)
/compression/experiments/replication-uneven-ptq/calib/

# LaTeX build artifacts
/compression/report/*.aux
/compression/report/*.out
/compression/report/*.log
/compression/report/*.bbl
/compression/report/*.blg
/compression/report/main.pdf

# ---------------------------------------------------------------------------
# speech-translation/ — the NLLB + XTTS dubbing pipeline.
# Corpora and reference audio are regenerable (fetch_flores.py,
# prepare_ref_audio.py); model conversions and bulk synthesis are not kept.
# Small results.json / summary.tsv ARE committed — they are the measurements.
# ---------------------------------------------------------------------------
/speech-translation/data/
/speech-translation/logs/
/speech-translation/mobile-tts/data/*.csv
/speech-translation/mobile-tts/checkpoints/
# CTranslate2 / GGUF / safetensors model conversions
/speech-translation/results/**/ct2_*/
*.gguf
*.safetensors

# Synthesized audio: keep one curated fp16-vs-int8 English pair as the demo,
# plus the mobile-tts listening set; the rest stays local.
/speech-translation/results/**/*.wav
!/speech-translation/results/xtts/*/en/0000.wav
/speech-translation/mobile-tts/outputs/sentence_*.wav

# ---------------------------------------------------------------------------
# interlingua/ — the training-dynamics track.
# The paper PDFs are ~191 MB and all recoverable from arXiv / ACL Anthology /
# transformer-circuits.pub; papers/README.md indexes them, and the two
# markdown companions (summaries + literature sweep) ARE committed.
# ---------------------------------------------------------------------------
/interlingua/papers/**/*.pdf
/interlingua/checkpoints/
/interlingua/results/
/interlingua/data/

# Logs
logs/
*.log
# SLURM job stdout (one finetune log is 2 MB of progress bars)
*.out

# Generated figures — committed ones are explicitly re-included below
*.png
!docs/**/*.png
!/compression/report/figures/*.png
!/speech-translation/**/*.png

# Crash core dumps
core.*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
